#!/bin/sh
# 電験Wiki pre-commit フック
# - audit_frequency.py: 出題頻度の整合性（kijun/のみ・NG件あればブロック）
# - check_frequency_consistency.py: メタ自動値と手書き値の矛盾（全89ファイル・NG件あればブロック）
# - check_kakomon_consistency.py: 過去問テーブルとby-field.mdの整合性（警告のみ）
# - audit_titles.py: kijun/ H1 と省令公式条見出しの整合性（NG件あればブロック・R6機械化）
# - check_law_citations.py: 法令引用整合性（電気事業法第N条＋認可/届出/対象 の検証・NG件あればブロック）
# - check_law_facts.py: 法令数値ハルシネーション類型検出（H01-H05・ERRORあればブロック / H03-H05はWARNING）
# - check_value_consistency.py: 数値クロス整合（V01 MΩ太字=ERRORブロック / plain Ω・V02三段値=WARNING report）
# - check_mojibake.py: U+FFFD 置換文字・不正バイト列の混入検出（docs/_data 変更時・NG件あればブロック）
# - [先頭ガード] master/main への直接コミットを禁止（feature→PR を強制）

# === master 直コミット禁止ガード（feedback-denken-wiki-master-branch-workflow）===
# local master への直接コミットは origin と乖離し未push成果を孤立させる事故の温床。
# 必ず feature ブランチ → PR → squash-merge を通すこと。
_guard_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
if [ "$_guard_branch" = "master" ] || [ "$_guard_branch" = "main" ]; then
    echo "❌ [pre-commit] '$_guard_branch' への直接コミットは禁止です。"
    echo "→ feature ブランチを切ってコミットし、PR 経由でマージしてください:"
    echo "     git switch -c feature/<topic>"
    echo "   緊急時のみ git commit --no-verify でスキップ可能（非推奨）。"
    exit 1
fi

set -e
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 条文記事配下またはby-field.mdが変更されたときだけ実行（高速化）
CHANGED=$(git diff --cached --name-only)

# 0. kakomon.yml ↔ by-year.md / 年度ページ 同期ガード（NEED_CHECK 早期 exit より前に実行）
#    by-year.md 手動メンテ時代のドリフト（R06/R07 が丸ごと別問題化）の再発防止。
#    -f ガードで旧worktree（スクリプト未配置）での誤ブロックを回避する。
NEED_PAGES_SYNC=$(echo "$CHANGED" | grep -E '^(_data/kakomon\.yml|docs/_data/kakomon\.yml|docs/kakomon/(by-year|H[12][0-9]|H30|R0[1-7])\.md|scripts/(gen_kakomon_by_year|check_kakomon_pages_sync)\.py)$' || true)
if [ -n "$NEED_PAGES_SYNC" ] && [ -f scripts/check_kakomon_pages_sync.py ]; then
    set +e
    PAGES_SYNC_RESULT=$(PYTHONIOENCODING=utf-8 python scripts/check_kakomon_pages_sync.py 2>&1)
    PAGES_SYNC_EXIT=$?
    set -e
    if [ "$PAGES_SYNC_EXIT" -ne "0" ]; then
        echo "❌ [pre-commit] kakomon.yml と by-year.md / 年度ページ がズレています。"
        echo "$PAGES_SYNC_RESULT" | tail -30
        echo ""
        echo "→ by-year.md 再生成: python scripts/gen_kakomon_by_year.py"
        echo "  年度ページは kakomon.yml に合わせて topic/article を是正してください。"
        echo "  緊急時は --no-verify でスキップ可能。"
        exit 1
    fi
fi

# 0.5 文字化け（U+FFFD・不正バイト列）混入ゲート（docs/_data の md/yml 変更時・NG件あればブロック）
#     by-field.md の問番号セル破損 3 行が全監査の正規表現から不可視になった事故（PR #74）の再発防止。
#     NEED_CHECK 早期 exit より前に置く（themes/ 等 articles 以外の md でも発火させる）。
#     -f ガードで旧worktree（スクリプト未配置）での誤ブロックを回避する。
NEED_MOJIBAKE_CHECK=$(echo "$CHANGED" | grep -E '^(docs/.+\.(md|yml|yaml)|_data/.+\.(yml|yaml)|scripts/check_mojibake\.py)$' || true)
if [ -n "$NEED_MOJIBAKE_CHECK" ] && [ -f scripts/check_mojibake.py ]; then
    set +e
    MOJIBAKE_RESULT=$(PYTHONIOENCODING=utf-8 python scripts/check_mojibake.py 2>&1)
    MOJIBAKE_EXIT=$?
    set -e
    if [ "$MOJIBAKE_EXIT" -ne "0" ]; then
        echo "❌ [pre-commit] U+FFFD 置換文字（文字化け）または不正な UTF-8 バイト列を検出しました。"
        echo "$MOJIBAKE_RESULT" | tail -30
        echo ""
        echo "→ 化け前の文字を前後の文脈・git 履歴から特定して復元してください。"
        echo "  検出: python scripts/check_mojibake.py"
        echo "  rule: memory project-by-field-corruption-and-refs-merge-gotchas / PR #74"
        echo "  緊急時は --no-verify でスキップ可能（非推奨）。"
        exit 1
    fi
fi

NEED_CHECK=$(echo "$CHANGED" | grep -E '^(docs/articles/(kijun|kaishaku|jigyoho|other)/|docs/kakomon/by-field\.md|scripts/(audit_frequency|check_frequency_consistency|check_kakomon_consistency|audit_titles)\.py)' || true)

if [ -z "$NEED_CHECK" ]; then
    exit 0
fi

echo "🔍 [pre-commit] 過去問・出題頻度の整合性をチェック中..."

# 1. 出題頻度監査（kijun/のみ・不整合あればブロック）
FREQ_RESULT=$(python scripts/audit_frequency.py 2>&1)
FREQ_ISSUES=$(echo "$FREQ_RESULT" | grep -oE "頻度不整合: [0-9]+件" | grep -oE "[0-9]+" || echo "0")

if [ "$FREQ_ISSUES" -gt "0" ]; then
    echo "❌ [pre-commit] 出題頻度（kijun）に $FREQ_ISSUES 件の不整合があります。"
    echo "$FREQ_RESULT" | tail -20
    echo ""
    echo "→ 修正してから再commitしてください。緊急時は --no-verify でスキップ可能。"
    exit 1
fi

# 2. メタ自動値と手書き値の矛盾検出（全89ファイル・不整合あればブロック）
CONS_RESULT=$(python scripts/check_frequency_consistency.py 2>&1)
CONS_ISSUES=$(echo "$CONS_RESULT" | grep -oE "矛盾検出: [0-9]+件" | grep -oE "[0-9]+" || echo "0")

if [ "$CONS_ISSUES" -gt "0" ]; then
    echo "❌ [pre-commit] メタ vs 手書きの矛盾が $CONS_ISSUES 件あります（全89ファイル監視）。"
    echo "$CONS_RESULT" | tail -20
    echo ""
    echo "→ 手書き「**出題頻度**: N回/14年」行を削除し、メタブロックを真とする。"
    echo "  自動修正: python scripts/check_frequency_consistency.py --fix"
    exit 1
fi

# 3. 過去問整合性（警告のみ・ブロックしない）
KAKO_RESULT=$(python scripts/check_kakomon_consistency.py 2>&1)
KAKO_ISSUES=$(echo "$KAKO_RESULT" | grep -oE "不整合 [0-9]+ 件" | grep -oE "[0-9]+" | head -1 || echo "0")

if [ "$KAKO_ISSUES" -gt "0" ]; then
    echo "⚠️  [pre-commit] 過去問整合性に $KAKO_ISSUES 件の不整合（警告のみ、commit続行）"
fi

# 4. H1 タイトル ↔ 省令公式条見出しの整合性（R6 機械化・staged のみ高速化・NG件あればブロック）
NEED_TITLES_CHECK=$(echo "$CHANGED" | grep -E '^docs/articles/kijun/.+\.md$' || true)
if [ -n "$NEED_TITLES_CHECK" ]; then
    set +e
    TITLES_RESULT=$(python scripts/audit_titles.py --staged --strict 2>&1)
    TITLES_EXIT=$?
    set -e
    if [ "$TITLES_EXIT" -ne "0" ]; then
        echo "❌ [pre-commit] kijun/ の H1 が省令公式条見出しと不一致です（R6 違反）。"
        echo "$TITLES_RESULT" | tail -15
        echo ""
        echo "→ 公式条見出しに合わせて修正してください。"
        echo "  確認: python scripts/audit_titles.py"
        echo "  一次ソース: e-Gov 法令検索 API 409M50000400052"
        echo "  緊急時は --no-verify でスキップ可能（非推奨）。"
        exit 1
    fi
fi

# 5. 法令引用整合性（変更された .md ファイルのみ高速化・NG件あればブロック）
NEED_LAW_CHECK=$(echo "$CHANGED" | grep -E '^docs/.+\.md$' || true)
if [ -n "$NEED_LAW_CHECK" ]; then
    set +e
    # staged のファイルだけを対象に検査
    STAGED_MD_FILES=$(echo "$CHANGED" | grep -E '^docs/.+\.md$' | tr '\n' ' ')
    LAW_RESULT=$(python scripts/check_law_citations.py $STAGED_MD_FILES 2>&1)
    LAW_EXIT=$?
    set -e
    if [ "$LAW_EXIT" -ne "0" ]; then
        echo "❌ [pre-commit] 法令引用に不整合があります。"
        echo "$LAW_RESULT" | tail -20
        echo ""
        echo "→ _data/law_articles.yml と照合して修正してください。"
        echo "  一次ソース: e-Gov 法令検索 (https://laws.e-gov.go.jp/)"
        echo "  緊急時は --no-verify でスキップ可能。"
        exit 1
    fi
fi

# 6. redirect_maps 衝突検出（mkdocs.yml 変更時のみ高速化・NG件あればブロック）
# Phase E (2026-05-24) redirect bug 再発防止
# feedback_redirect_vs_new_file_collision
NEED_REDIRECT_CHECK=$(echo "$CHANGED" | grep -E '^(mkdocs\.yml|docs/articles/.+\.md)$' || true)
if [ -n "$NEED_REDIRECT_CHECK" ]; then
    set +e
    REDIRECT_RESULT=$(python scripts/precommit_redirect_collision.py 2>&1)
    REDIRECT_EXIT=$?
    set -e
    if [ "$REDIRECT_EXIT" -ne "0" ]; then
        echo "❌ [pre-commit] redirect_maps と docs/ 実在ファイルが衝突しています。"
        echo "$REDIRECT_RESULT" | tail -20
        echo ""
        echo "→ 該当 redirect_maps entry を削除してください（新規ファイル実体を優先）。"
        echo "  rule: feedback_redirect_vs_new_file_collision"
        echo "  検出: python scripts/precommit_redirect_collision.py"
        echo "  緊急時は --no-verify でスキップ可能。"
        exit 1
    fi
fi

# 7. kakomon.yml article-topic 整合性監査（kakomon.yml 変更時のみ高速化・ERRORありブロック）
# 2026-05-26 ChatGPT監修発覚の H29問9 §224 誤記再発防止
# feedback_kakomon_article_topic_audit / feedback_external_review_blindspot_analysis
NEED_KAKOMON_CHECK=$(echo "$CHANGED" | grep -E '^(_data/kakomon\.yml|docs/_data/kakomon\.yml|scripts/audit_kakomon_article\.py)$' || true)
if [ -n "$NEED_KAKOMON_CHECK" ]; then
    set +e
    KAKOMON_AUDIT_RESULT=$(PYTHONIOENCODING=utf-8 python scripts/audit_kakomon_article.py 2>&1)
    KAKOMON_AUDIT_EXIT=$?
    set -e
    if [ "$KAKOMON_AUDIT_EXIT" -ne "0" ]; then
        echo "❌ [pre-commit] kakomon.yml の article欄と topic欄が不整合です。"
        echo "$KAKOMON_AUDIT_RESULT" | tail -30
        echo ""
        echo "→ topic に対応する正しい article 値に修正してください（両ファイル要更新）。"
        echo "  rule: feedback_kakomon_article_topic_audit"
        echo "  検出: PYTHONIOENCODING=utf-8 python scripts/audit_kakomon_article.py"
        echo "  緊急時は --no-verify でスキップ可能。"
        exit 1
    fi
    # 範囲表記 warning は continue（既存大量存在・別タスクで段階対処）
fi

# 8. 法令数値ハルシネーション類型検出（docs/ .md 変更時・ERRORあればブロック）
# 2026-05-31 ChatGPT・古舘さん指摘3件(H01/H02/H03)の再発防止
# feedback_law_value_conservation_bias / feedback_hallucination_taxonomy
NEED_LAW_FACTS_CHECK=$(echo "$CHANGED" | grep -E '^docs/.+\.md$' || true)
if [ -n "$NEED_LAW_FACTS_CHECK" ]; then
    set +e
    LAW_FACTS_RESULT=$(PYTHONIOENCODING=utf-8 python scripts/check_law_facts.py --staged 2>&1)
    LAW_FACTS_EXIT=$?
    set -e
    if [ "$LAW_FACTS_EXIT" -ne "0" ]; then
        echo "❌ [pre-commit] 法令数値ハルシネーション類型を検出しました（check_law_facts.py）。"
        echo "$LAW_FACTS_RESULT"
        echo ""
        echo "→ 上記の誤記を修正してから再commitしてください。"
        echo "  H01: 解釈第14条の根拠は「漏えい電流1mA以下」(1/2000は省令第22条/電線路)"
        echo "  H02: 低圧電路の活線代替根拠は第14条第1項第二号(第15条は高圧・特高の耐圧試験)"
        echo "  H03: 三相3線式200VはΔ結線主流→対地200V→0.2MΩ(B種接地のみで0.1MΩと断定しない)"
        echo "  H04: 単相3線式200Vは中性線接地で対地100V→0.1MΩ(0.2MΩは三相3線式の値)"
        echo "  H05: 三相3線式200VはΔ結線で対地200V→0.2MΩ(0.1MΩは単相3線式の値)"
        echo "  一次ソース: 解釈第14条第1項第二号・省令第22条・省令第58条"
        echo "  確認: python scripts/check_law_facts.py"
        echo "  緊急時は --no-verify でスキップ可能（非推奨）。"
        exit 1
    fi
fi

# 9. 数値クロス整合（value-correction sweep 検出・docs/.md 変更時）
#    V01 Ω太字バグ（MΩ・plain Ω とも ERROR・ブロック）/ V02 三段値の自己不整合（WARNING・report）。
#    2026-06-10: MΩ 28件を PR #59 で一掃 → MΩ blocking 化。同日 plain Ω 111箇所/19ファイルも
#    docs/ 全域 --fix で一掃し ERROR へ昇格（severity 分岐撤廃・ドリフト0維持）。
#    ビルド時フック hooks/bold_unit_separator.py は実行時の安全網（本ゲートが一次防衛線）。
NEED_VALUE_CHECK=$(echo "$CHANGED" | grep -E '^docs/.+\.md$' || true)
if [ -n "$NEED_VALUE_CHECK" ] && [ -f scripts/check_value_consistency.py ]; then
    set +e
    VALUE_RESULT=$(PYTHONIOENCODING=utf-8 python scripts/check_value_consistency.py --staged 2>&1)
    VALUE_EXIT=$?
    set -e
    if [ "$VALUE_EXIT" -ne "0" ]; then
        echo "❌ [pre-commit] Ω太字バグ（V01-ERROR・MΩ/plain Ω とも）を検出しました。"
        echo "$VALUE_RESULT" | tail -30
        echo ""
        echo "→ 数値だけ太字に（**0.1MΩ**→**0.1**MΩ / **10Ω以下**→**10**Ω以下）。"
        echo "  一掃: python scripts/check_value_consistency.py docs --fix"
        echo "  rule: CLAUDE.md「MΩ表記ルール」/ memory: feedback-value-correction-sweep"
        echo "  緊急時は --no-verify でスキップ可能（非推奨）。"
        exit 1
    fi
    # WARNING（V02 三段値）は report-only（commit続行）
    if echo "$VALUE_RESULT" | grep -q "WARNING [1-9]"; then
        echo "⚠️  [pre-commit] 数値クロス整合 WARNING（commit続行・report-only）:"
        echo "$VALUE_RESULT" | tail -15
    fi
fi

echo "✅ [pre-commit] チェック完了"
exit 0

#!/bin/sh
# 電験Wiki pre-commit フック
# - audit_frequency.py: 出題頻度の整合性（kijun/のみ・NG件あればブロック）
# - check_frequency_consistency.py: メタ自動値と手書き値の矛盾（全89ファイル・NG件あればブロック）
# - check_kakomon_consistency.py: 過去問テーブルとby-field.mdの整合性（警告のみ）
# - audit_titles.py: kijun/ H1 と省令公式条見出しの整合性（NG件あればブロック・R6機械化）
# - check_law_citations.py: 法令引用整合性（電気事業法第N条＋認可/届出/対象 の検証・NG件あればブロック）

set -e
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 条文記事配下またはby-field.mdが変更されたときだけ実行（高速化）
CHANGED=$(git diff --cached --name-only)
NEED_CHECK=$(echo "$CHANGED" | grep -E '^(docs/articles/(kijun|kaishaku|jigyoho|other)/|docs/kakomon/by-field\.md|scripts/(audit_frequency|check_frequency_consistency|check_kakomon_consistency|audit_titles)\.py)' || true)

if [ -z "$NEED_CHECK" ]; then
    exit 0
fi

echo "🔍 [pre-commit] 過去問・出題頻度の整合性をチェック中..."

# 1. 出題頻度監査（kijun/のみ・不整合あればブロック）
FREQ_RESULT=$(python scripts/audit_frequency.py 2>&1)
FREQ_ISSUES=$(echo "$FREQ_RESULT" | grep -oE "頻度不整合: [0-9]+件" | grep -oE "[0-9]+" || echo "0")

if [ "$FREQ_ISSUES" -gt "0" ]; then
    echo "❌ [pre-commit] 出題頻度（kijun）に $FREQ_ISSUES 件の不整合があります。"
    echo "$FREQ_RESULT" | tail -20
    echo ""
    echo "→ 修正してから再commitしてください。緊急時は --no-verify でスキップ可能。"
    exit 1
fi

# 2. メタ自動値と手書き値の矛盾検出（全89ファイル・不整合あればブロック）
CONS_RESULT=$(python scripts/check_frequency_consistency.py 2>&1)
CONS_ISSUES=$(echo "$CONS_RESULT" | grep -oE "矛盾検出: [0-9]+件" | grep -oE "[0-9]+" || echo "0")

if [ "$CONS_ISSUES" -gt "0" ]; then
    echo "❌ [pre-commit] メタ vs 手書きの矛盾が $CONS_ISSUES 件あります（全89ファイル監視）。"
    echo "$CONS_RESULT" | tail -20
    echo ""
    echo "→ 手書き「**出題頻度**: N回/14年」行を削除し、メタブロックを真とする。"
    echo "  自動修正: python scripts/check_frequency_consistency.py --fix"
    exit 1
fi

# 3. 過去問整合性（警告のみ・ブロックしない）
KAKO_RESULT=$(python scripts/check_kakomon_consistency.py 2>&1)
KAKO_ISSUES=$(echo "$KAKO_RESULT" | grep -oE "不整合 [0-9]+ 件" | grep -oE "[0-9]+" | head -1 || echo "0")

if [ "$KAKO_ISSUES" -gt "0" ]; then
    echo "⚠️  [pre-commit] 過去問整合性に $KAKO_ISSUES 件の不整合（警告のみ、commit続行）"
fi

# 4. H1 タイトル ↔ 省令公式条見出しの整合性（R6 機械化・staged のみ高速化・NG件あればブロック）
NEED_TITLES_CHECK=$(echo "$CHANGED" | grep -E '^docs/articles/kijun/.+\.md$' || true)
if [ -n "$NEED_TITLES_CHECK" ]; then
    set +e
    TITLES_RESULT=$(python scripts/audit_titles.py --staged --strict 2>&1)
    TITLES_EXIT=$?
    set -e
    if [ "$TITLES_EXIT" -ne "0" ]; then
        echo "❌ [pre-commit] kijun/ の H1 が省令公式条見出しと不一致です（R6 違反）。"
        echo "$TITLES_RESULT" | tail -15
        echo ""
        echo "→ 公式条見出しに合わせて修正してください。"
        echo "  確認: python scripts/audit_titles.py"
        echo "  一次ソース: e-Gov 法令検索 API 409M50000400052"
        echo "  緊急時は --no-verify でスキップ可能（非推奨）。"
        exit 1
    fi
fi

# 5. 法令引用整合性（変更された .md ファイルのみ高速化・NG件あればブロック）
NEED_LAW_CHECK=$(echo "$CHANGED" | grep -E '^docs/.+\.md$' || true)
if [ -n "$NEED_LAW_CHECK" ]; then
    set +e
    # staged のファイルだけを対象に検査
    STAGED_MD_FILES=$(echo "$CHANGED" | grep -E '^docs/.+\.md$' | tr '\n' ' ')
    LAW_RESULT=$(python scripts/check_law_citations.py $STAGED_MD_FILES 2>&1)
    LAW_EXIT=$?
    set -e
    if [ "$LAW_EXIT" -ne "0" ]; then
        echo "❌ [pre-commit] 法令引用に不整合があります。"
        echo "$LAW_RESULT" | tail -20
        echo ""
        echo "→ _data/law_articles.yml と照合して修正してください。"
        echo "  一次ソース: e-Gov 法令検索 (https://laws.e-gov.go.jp/)"
        echo "  緊急時は --no-verify でスキップ可能。"
        exit 1
    fi
fi

echo "✅ [pre-commit] チェック完了"
exit 0
